{
  "name": "json-toolbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A desktop-style JSON toolbox: format, tree view, diff, JSONPath, schema generation, format conversion and more. All data is processed locally in the browser.",
  "license": "MIT",
  "author": "JSON Toolbox contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shigc/json-toolbox.git"
  },
  "homepage": "https://json.shigc.top/",
  "bugs": {
    "url": "https://github.com/shigc/json-toolbox/issues"
  },
  "keywords": [
    "json",
    "json-formatter",
    "jsonpath",
    "json-diff",
    "json-schema",
    "mock-data",
    "yaml",
    "excel",
    "developer-tools",
    "vue",
    "vite",
    "offline"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:release": "vue-tsc --noEmit && vite build --mode release",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "preview:release": "vite preview --outDir dist-release",
    "deploy": "npm run build:release && wrangler pages deploy dist-release --project-name=json-toolbox --branch=main",
    "deploy:only": "wrangler pages deploy dist-release --project-name=json-toolbox --branch=main",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@faker-js/faker": "^10.6.0",
    "@lezer/highlight": "^1.2.1",
    "codemirror": "^6.0.2",
    "fast-xml-parser": "^5.11.2",
    "jsondiffpatch": "^0.7.6",
    "jsonpath-plus": "^11.2.1",
    "papaparse": "^5.7.0",
    "pinia": "^4.0.3",
    "smol-toml": "^1.9.1",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.14",
    "vue-router": "^4.5.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.3.15",
    "@vitejs/plugin-vue": "^6.0.0",
    "javascript-obfuscator": "^5.9.0",
    "terser": "^5.51.2",
    "typescript": "^5.7.0",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vue-tsc": "^3.0.0",
    "wrangler": "^4.151.0"
  }
}
